# Postgres connection string (Neon recommended — see spec §9 re: connection pooling on serverless).
# Use the pooled connection string for DATABASE_URL and the direct one for DIRECT_URL if your
# provider distinguishes them (Neon does).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# SMTP (NextAuth Email provider — magic links)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="username"
EMAIL_SERVER_PASSWORD="password"
EMAIL_FROM="Flipdeck <no-reply@foundationalrealestate.co>"

# Anthropic — powers "Smart add" (paste expenses, AI maps them) in Bulk Import.
# Without a key, the rest of the app works; only Smart add is disabled.
# Get a key at https://console.anthropic.com. ANTHROPIC_MODEL is optional
# (defaults to claude-opus-5; set claude-sonnet-5 or claude-haiku-4-5 to spend less).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Cloudflare R2 (S3-compatible) — receipts and company logo
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="flipdeck"
R2_PUBLIC_URL="https://<bucket>.<account>.r2.dev"
